# Copy this file to .env and replace local credentials before starting services.

# Source registry and website-specific configuration
SOURCE_REGISTRY_PATH=config/source_registry.json
WRC_CONFIG_PATH=config/wrc_ie.json

# Direct Scrapy crawl defaults; -a arguments can override the dates.
SCRAPE_START_DATE=
SCRAPE_END_DATE=
SCRAPE_PARTITION_MONTHS=1
SCRAPE_MODE=full
CRAWL_SUMMARY_PATH=
CRAWL_PROFILE_PATH=

# Conservative cross-site Scrapy defaults.
# Benchmark each source separately and put validated source overrides in
# config/source_registry.json instead of raising these global fallbacks.
SCRAPY_USER_AGENT=KedraScraper/1.0
SCRAPY_LOG_LEVEL=INFO
SCRAPY_ROBOTSTXT_OBEY=true
SCRAPY_COOKIES_ENABLED=false
SCRAPY_TELNETCONSOLE_ENABLED=false
SCRAPY_FEED_EXPORT_ENCODING=utf-8
SCRAPY_ACCEPT_HEADER=text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8
SCRAPY_ACCEPT_LANGUAGE=en
SCRAPY_CONCURRENT_REQUESTS=16
SCRAPY_CONCURRENT_REQUESTS_PER_DOMAIN=2
SCRAPY_DOWNLOAD_DELAY=0.5
SCRAPY_RANDOMIZE_DOWNLOAD_DELAY=true
SCRAPY_DOWNLOAD_TIMEOUT=30
SCRAPY_RETRY_TIMES=3
SCRAPY_AUTOTHROTTLE_ENABLED=true
SCRAPY_AUTOTHROTTLE_START_DELAY=0.5
SCRAPY_AUTOTHROTTLE_MAX_DELAY=30
SCRAPY_AUTOTHROTTLE_TARGET_CONCURRENCY=1
SCRAPY_AUTOTHROTTLE_DEBUG=false

# Structured crawl logs
SCRAPY_LOG_DIR=logs
SCRAPY_STRUCTURED_LOG_PATH=
SCRAPY_LOG_MAX_BYTES=25000000
SCRAPY_LOG_BACKUP_COUNT=5

# Persistence switch and transient-operation retries
PERSISTENCE_ENABLED=false
PERSISTENCE_RETRY_TIMES=2
PERSISTENCE_RETRY_BASE_DELAY_SECONDS=0.5
PERSISTENCE_RETRY_MAX_DELAY_SECONDS=5

# MongoDB application connection
# Keep MONGO_URI credentials aligned with MONGO_USERNAME/MONGO_PASSWORD below.
# Percent-encode URI-reserved characters if you use them in the password.
MONGO_USERNAME=kedra_user
MONGO_PASSWORD=change_me_mongo_password
MONGO_URI=mongodb://kedra_user:change_me_mongo_password@localhost:27017/?authSource=admin
MONGO_DATABASE=kedra
MONGO_COLLECTION=documents
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# MongoDB Docker service
MONGO_IMAGE=mongo:8.0
MONGO_CONTAINER_NAME=kedra-mongodb
MONGO_BIND_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATA_PATH=mongodb_data

# MinIO application connection
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kedra_minio
MINIO_SECRET_KEY=change_me_minio_password
MINIO_SECURE=false
MINIO_BUCKET=kedra-documents
MINIO_PREFIX=documents

# MinIO Docker service
MINIO_IMAGE=minio/minio:latest
MINIO_CONTAINER_NAME=kedra-minio
MINIO_BIND_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_PATH=minio_data

# Dagster monthly partitions and schedule
DAGSTER_PARTITION_START_DATE=2000-01-01
DAGSTER_PARTITION_END_DATE=
DAGSTER_PARTITION_TIMEZONE=Europe/Dublin
DAGSTER_PARTITION_END_OFFSET=0
DAGSTER_SCHEDULE_CRON="0 2 1 * *"

# Dagster asset retries and subprocess controls
DAGSTER_CRAWL_MAX_RETRIES=2
DAGSTER_CRAWL_RETRY_DELAY_SECONDS=30
DAGSTER_CRAWL_TIMEOUT_SECONDS=7200
DAGSTER_CRAWL_LOG_LEVEL=INFO
DAGSTER_BENCHMARK_TIMEOUT_SECONDS=14400
DAGSTER_SUBPROCESS_LOG_TAIL_LINES=80
DAGSTER_SUBPROCESS_LOG_TAIL_CHARACTERS=12000

# Dagster partition acceptance thresholds
DAGSTER_MAX_REQUEST_FAILURES=0
DAGSTER_MAX_PERSISTENCE_ERRORS=0
DAGSTER_MAX_UNEXPLAINED_MISSING=0
DAGSTER_FAIL_ON_SCRAPING_ERRORS=false

# Maximum MongoDB error-message length for one failed extracted document
SCRAPING_ERROR_MAX_CHARS=500

